# Root-level env vars shared across deploy tooling.
# Copy to .env, fill in real values. Never commit .env.

# Public DDNS hostname for pwm-app (see PROXMOX_NETWORK.md)
PWM_PUBLIC_HOST=REDACTED-DDNS-HOST.example.com

# GHCR image tag pulled by docker-compose on pwm-app (see DEPLOY.md)
PWM_IMAGE_TAG=latest
