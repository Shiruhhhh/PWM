# Copy to scripts/.env, fill in real values. Never commit .env.
# Used by deploy-apk.sh to push a built release APK to pwm-app and bump
# the version the backend reports via GET /app/version -- see
# TASKS.md Phase 7 / docs/DEPLOY.md.

# SSH target for pwm-app (host[:port], must have your key authorized).
DEPLOY_SSH_HOST="user@192.168.1.10"

# Path on pwm-app that GET /app/version and GET /app/apk read from --
# must match that container/host's APP_RELEASES_DIR env var.
DEPLOY_REMOTE_DIR="/etc/pwm-app-releases"
