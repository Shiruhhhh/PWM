# Copy to .env, fill in real values. Never commit .env.

DATABASE_URL="postgresql://pwm:pwm@localhost:5432/pwm?schema=public"

# Port the Fastify app listens on (fronted by Caddy, see docs/DEPLOY.md)
PORT=3000

# 32+ random bytes, base64. Used only to derive a stable-but-fake
# clientSalt for GET /login/params on nonexistent usernames (anti
# username-enumeration, see docs/API_SPEC.md). Generate with:
#   openssl rand -base64 32
ENUMERATION_HMAC_SECRET=""

# pwm-ca's internal base URL (see docs/CA_SERVICE_SPEC.md,
# docs/PROXMOX_NETWORK.md). Used for cert renewal forwarding and CRL
# polling. Leave unset to disable CRL polling (e.g. local dev).
CA_SERVICE_URL="https://192.168.1.11:8443"
