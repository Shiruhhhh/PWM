# Copy to .env, fill in real values. Never commit .env.
# Baked into the APK at build time via react-native-config (Config.FOO in JS).
# Per docs/DECISIONS.md #22's two-listener design:

# Public mTLS listener (port 443, your DDNS hostname) -- everything except
# /register and /cert/initial.
SERVER_URL=https://your-ddns-host.example.com

# LAN/VPN-only listener (port 8443, LAN IP) -- only reachable on the home
# LAN/VPN, only ever used for /register and /cert/initial during first-device
# setup.
BOOTSTRAP_URL=https://192.168.1.10:8443
