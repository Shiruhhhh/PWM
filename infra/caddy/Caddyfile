# PWM Caddy config — TWO separate listeners, per docs/DECISIONS.md #22
# and docs/API_SPEC.md. Both point at the same Fastify app, but
# client-cert verification happens at the TLS layer, before Caddy can
# route by HTTP path — so this genuinely needs two site blocks on two
# different bind addresses/ports, not a path rule on one listener.
#
# Runs on pwm-proxy (CT 200), NOT pwm-app (CT 201) -- per
# docs/DECISIONS.md's reverse-proxy migration entry, Caddy moved to a
# shared LXC since the router can only forward port 443 to one internal
# IP, and a second project needs it too. reverse_proxy targets below
# point at pwm-app's LAN IP (192.168.1.10:3000) over the network, not a
# Docker Compose service name -- these two containers no longer share a
# Docker network.
#
# NOTE: stock Caddy's client_auth only verifies a cert chains to the
# trusted CA — it has no CRL/revocation support. A *revoked* cert still
# passes this check and gets rejected one layer up, by the app (see
# docs/CA_SERVICE_SPEC.md and docs/DECISIONS.md #17).
#
# {$PWM_PUBLIC_HOST} must be set to the real subdomain
# (pwm.<your-ddns-host>, see root .env.example) — Caddy uses it to
# request/renew a Let's Encrypt cert.

# Public listener, port 443, full mTLS. Everything EXCEPT the
# bootstrap-only routes below -- those also exist in the same Fastify
# app (Fastify itself has no listener concept; Caddy is what separates
# them), so this block explicitly denies them here as defense in depth,
# on top of the Proxmox firewall rule that keeps this listener's
# underlying port reachable from the internet while the LAN-only
# listener's port (8443) never is (see docs/PROXMOX_NETWORK.md).
{$PWM_PUBLIC_HOST} {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/pwm/ca.crt
		}
	}

	# /login/params is NOT in this deny-list -- it's a normal public-
	# listener route (LoginScreen's own flow uses it over mTLS every
	# time), always has been. Only /cert/initial-for-existing-user is
	# added here alongside /register + /cert/initial: a device that
	# already has a valid cert (i.e. can reach this listener at all)
	# never needs the no-cert re-pairing flow, so denying it here is
	# correct defense in depth, same reasoning as the other two.
	@bootstrapOnlyRoutes path /register /cert/initial /cert/initial-for-existing-user

	# `route` forces explicit top-to-bottom order -- Caddy's default
	# directive-type precedence runs `respond` before `reverse_proxy`
	# regardless of write order or matchers, which would silently 404
	# every request (matched or not) if these weren't wrapped like this.
	route {
		respond @bootstrapOnlyRoutes 404
		reverse_proxy 192.168.1.10:3000 {
			# Forward the verified client cert (DER, base64, RFC 9440
			# Client-Cert format) so the app can compute its fingerprint and
			# check it against the CRL — Caddy only verifies the cert chains
			# to our CA, it has no revocation support (see
			# docs/CA_SERVICE_SPEC.md, docs/DECISIONS.md #17).
			header_up Client-Cert :{tls_client_certificate_der_base64}:
		}
	}

	log {
		output file /var/log/caddy/pwm-access.log
		format json
	}
}

# LAN/VPN-only listener, port 8443. Plain TLS, NO client_auth — a
# brand-new device has no cert yet, that's the whole point. Reachability
# is restricted entirely by the Proxmox firewall (192.168.1.0/24 only,
# never port-forwarded on the router — see docs/PROXMOX_NETWORK.md), not
# by anything in this Caddy config itself. Hosts ONLY the bootstrap-only
# routes below; everything else 404s here as defense in depth, on top
# of the firewall-level restriction.
#
# No hostname here (bare port, not a domain), so Caddy can't request a
# Let's Encrypt cert for it -- without an explicit `tls` directive it
# falls back to its own ad-hoc self-signed cert, which no mobile OS
# trusts by default. The mobile app can't use a normal HTTPS client for
# this listener as a result; see docs/DECISIONS.md #28 -- it pins
# against this exact cert (signed by our internal CA, reusing
# services/ca's existing infra) instead of relying on system trust.
:8443 {
	tls /etc/pwm/bootstrap-server.crt /etc/pwm/bootstrap-server.key

	# /login/params + /cert/initial-for-existing-user: re-pairs a device
	# to an EXISTING account (e.g. after a reinstall wiped the previous
	# cert) without going through /register, which 409s on the already-
	# taken username. See docs/DECISIONS.md.
	@bootstrapOnlyRoutes path /register /cert/initial /login/params /cert/initial-for-existing-user

	# Same explicit-ordering reasoning as the public listener above:
	# `respond` runs before `reverse_proxy` by default regardless of
	# matchers, so without `route` the unconditional 404 below would fire
	# for every request, including the two allowed paths.
	route {
		reverse_proxy @bootstrapOnlyRoutes 192.168.1.10:3000
		respond 404
	}

	log {
		output file /var/log/caddy/pwm-bootstrap-access.log
		format json
	}
}
